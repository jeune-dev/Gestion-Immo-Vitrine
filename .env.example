# URL de base de l'API (préfixe /api/v1 inclus), ex. http://localhost:3000/api/v1
VITE_API_URL=

# Application des propriétaires et locataires (lien « Se connecter » masqué si vide)
VITE_APP_URL=

# Coordonnées officielles (chaque lien est masqué si sa valeur est vide)
VITE_CONTACT_EMAIL=
# Format international sans espace, ex. +221770000000
VITE_CONTACT_PHONE=
# Numéro WhatsApp au format international sans « + » ni espace, ex. 221770000000
VITE_WHATSAPP_NUMBER=
